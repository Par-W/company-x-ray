<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.main.MainActivity">

    <!-- 可滚动内容区 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guardianSwitchBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_padding_horizontal"
            android:paddingTop="@dimen/page_padding_vertical"
            android:paddingBottom="@dimen/spacing_large">

            <!-- 顶部标题栏 -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_title"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/spacing_xsmall" />

            <!-- 守护状态大卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/risk_low"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="@dimen/elevation_card_high"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_large">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_xlarge">

                    <!-- 状态图标 -->
                    <ImageView
                        android:id="@+id/ivStatusIcon"
                        android:layout_width="@dimen/icon_size_xlarge"
                        android:layout_height="@dimen/icon_size_xlarge"
                        android:src="@drawable/ic_shield"
                        android:contentDescription="@null"
                        app:tint="@color/on_risk_low"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- 状态文字 -->
                    <TextView
                        android:id="@+id/tvStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_status_safe"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold"
                        android:textColor="@color/on_risk_low"
                        app:layout_constraintTop_toTopOf="@id/ivStatusIcon"
                        app:layout_constraintStart_toEndOf="@id/ivStatusIcon"
                        android:layout_marginStart="@dimen/spacing_large" />

                    <!-- 守护天数 -->
                    <TextView
                        android:id="@+id/tvGuardianDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_total_safe"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/on_risk_low"
                        app:layout_constraintTop_toBottomOf="@id/tvStatusText"
                        app:layout_constraintStart_toEndOf="@id/ivStatusIcon"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginTop="@dimen/spacing_small" />

                    <TextView
                        android:id="@+id/tvDaysCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_size_headline"
                        android:textStyle="bold"
                        android:textColor="@color/on_risk_low"
                        app:layout_constraintTop_toBottomOf="@id/tvGuardianDays"
                        app:layout_constraintStart_toEndOf="@id/ivStatusIcon"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginTop="@dimen/spacing_xsmall" />

                    <TextView
                        android:id="@+id/tvDaysUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_days"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/on_risk_low"
                        app:layout_constraintBottom_toBottomOf="@id/tvDaysCount"
                        app:layout_constraintStart_toEndOf="@id/tvDaysCount"
                        android:layout_marginStart="@dimen/spacing_xsmall"
                        android:layout_marginBottom="@dimen/spacing_xsmall" />

                    <!-- 今日已拦截 -->
                    <TextView
                        android:id="@+id/tvTodayBlocked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_today_safe"
                        android:textSize="@dimen/text_size_hint"
                        android:textColor="@color/on_risk_low"
                        app:layout_constraintBottom_toTopOf="@id/tvTodayCount"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvTodayCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        android:textColor="@color/on_risk_low"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvTimesUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_times"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/on_risk_low"
                        app:layout_constraintBottom_toBottomOf="@id/tvTodayCount"
                        app:layout_constraintEnd_toStartOf="@id/tvTodayCount"
                        android:layout_marginEnd="@dimen/spacing_xsmall"
                        android:layout_marginBottom="@dimen/spacing_small" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 功能入口标题 -->
            <TextView
                android:id="@+id/tvFeaturesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/family_bound_list"
                android:textSize="@dimen/text_size_subhead"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/cardStatus"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/spacing_xlarge" />

            <!-- 家人守护卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFamily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:layout_constraintTop_toBottomOf="@id/tvFeaturesTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_large">

                    <ImageView
                        android:id="@+id/ivFamilyIcon"
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@android:drawable/ic_menu_call"
                        android:contentDescription="@null"
                        app:tint="@color/secondary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvFamilyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/family_title"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:layout_constraintTop_toTopOf="@id/ivFamilyIcon"
                        app:layout_constraintStart_toEndOf="@id/ivFamilyIcon"
                        app:layout_constraintEnd_toStartOf="@id/ivFamilyArrow"
                        android:layout_marginStart="@dimen/spacing_large" />

                    <TextView
                        android:id="@+id/tvFamilyDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/family_bind_desc"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/text_secondary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintTop_toBottomOf="@id/tvFamilyTitle"
                        app:layout_constraintStart_toEndOf="@id/ivFamilyIcon"
                        app:layout_constraintEnd_toStartOf="@id/ivFamilyArrow"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginTop="@dimen/spacing_xsmall" />

                    <ImageView
                        android:id="@+id/ivFamilyArrow"
                        android:layout_width="@dimen/icon_size_normal"
                        android:layout_height="@dimen/icon_size_normal"
                        android:src="@android:drawable/ic_media_next"
                        android:contentDescription="@null"
                        app:tint="@color/text_hint"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 告警历史卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:layout_constraintTop_toBottomOf="@id/cardFamily"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_large">

                    <ImageView
                        android:id="@+id/ivHistoryIcon"
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@android:drawable/ic_menu_recent_history"
                        android:contentDescription="@null"
                        app:tint="@color/risk_medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvHistoryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/history_title"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:layout_constraintTop_toTopOf="@id/ivHistoryIcon"
                        app:layout_constraintStart_toEndOf="@id/ivHistoryIcon"
                        app:layout_constraintEnd_toStartOf="@id/ivHistoryArrow"
                        android:layout_marginStart="@dimen/spacing_large" />

                    <TextView
                        android:id="@+id/tvHistoryDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/alert_description"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/text_secondary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle"
                        app:layout_constraintStart_toEndOf="@id/ivHistoryIcon"
                        app:layout_constraintEnd_toStartOf="@id/ivHistoryArrow"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginTop="@dimen/spacing_xsmall" />

                    <ImageView
                        android:id="@+id/ivHistoryArrow"
                        android:layout_width="@dimen/icon_size_normal"
                        android:layout_height="@dimen/icon_size_normal"
                        android:src="@android:drawable/ic_media_next"
                        android:contentDescription="@null"
                        app:tint="@color/text_hint"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 设置卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:layout_constraintTop_toBottomOf="@id/cardHistory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_large">

                    <ImageView
                        android:id="@+id/ivSettingsIcon"
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@android:drawable/ic_menu_preferences"
                        android:contentDescription="@null"
                        app:tint="@color/primary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvSettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_title"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:layout_constraintTop_toTopOf="@id/ivSettingsIcon"
                        app:layout_constraintStart_toEndOf="@id/ivSettingsIcon"
                        app:layout_constraintEnd_toStartOf="@id/ivSettingsArrow"
                        android:layout_marginStart="@dimen/spacing_large" />

                    <TextView
                        android:id="@+id/tvSettingsDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notification"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/text_secondary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle"
                        app:layout_constraintStart_toEndOf="@id/ivSettingsIcon"
                        app:layout_constraintEnd_toStartOf="@id/ivSettingsArrow"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginTop="@dimen/spacing_xsmall" />

                    <ImageView
                        android:id="@+id/ivSettingsArrow"
                        android:layout_width="@dimen/icon_size_normal"
                        android:layout_height="@dimen/icon_size_normal"
                        android:src="@android:drawable/ic_media_next"
                        android:contentDescription="@null"
                        app:tint="@color/text_hint"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部守护开关栏 -->
    <LinearLayout
        android:id="@+id/guardianSwitchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="@dimen/page_padding_horizontal"
        android:paddingVertical="@dimen/padding_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="8dp">

        <ImageView
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:src="@drawable/ic_shield"
            android:contentDescription="@null"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/main_title"
            android:textSize="@dimen/text_size_subhead"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="@dimen/spacing_medium" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchGuardian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:textSize="@dimen/text_size_body" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
