<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alertItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingVertical="@dimen/padding_medium"
    android:paddingEnd="@dimen/padding_medium">

    <!-- 风险等级色条（左侧竖条） -->
    <View
        android:id="@+id/viewRiskColorBar"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@color/risk_high"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 商家名称 -->
    <TextView
        android:id="@+id/tvMerchant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="某电商平台"
        android:textSize="@dimen/text_size_subhead"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/viewRiskColorBar"
        app:layout_constraintEnd_toStartOf="@id/tvAmount"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_xsmall" />

    <!-- 金额（红色） -->
    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¥ 0.00"
        android:textSize="@dimen/text_size_subhead"
        android:textStyle="bold"
        android:textColor="@color/risk_high"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="@id/tvMerchant"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/spacing_small" />

    <!-- 时间 -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/history_time"
        android:textSize="@dimen/text_size_hint"
        android:textColor="@color/text_hint"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/tvMerchant"
        app:layout_constraintStart_toEndOf="@id/viewRiskColorBar"
        app:layout_constraintEnd_toStartOf="@id/badgeStatus"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_xsmall" />

    <!-- 状态标签（已通知/已送达/已查看/已确认） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/badgeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/risk_low_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvAmount"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_xsmall">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_handled"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/risk_low_dark"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="2dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 风险类型 -->
    <TextView
        android:id="@+id/tvRiskType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/alert_payment_risk"
        android:textSize="@dimen/text_size_hint"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tvTime"
        app:layout_constraintStart_toEndOf="@id/viewRiskColorBar"
        app:layout_constraintEnd_toStartOf="@id/badgeStatus"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_xsmall"
        android:layout_marginBottom="@dimen/spacing_xsmall" />

</androidx.constraintlayout.widget.ConstraintLayout>
