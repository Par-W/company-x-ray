<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchorItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingVertical="@dimen/spacing_medium">

    <!-- 左侧状态图标（✅/❌/⚪） -->
    <ImageView
        android:id="@+id/ivAnchorStatus"
        android:layout_width="@dimen/icon_size_normal"
        android:layout_height="@dimen/icon_size_normal"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="@null"
        app:tint="@color/text_on_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginEnd="@dimen/spacing_medium" />

    <!-- 中间锚点名称（16sp 加粗） -->
    <TextView
        android:id="@+id/tvAnchorName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/alert_payment_risk"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_dark"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/ivAnchorStatus"
        app:layout_constraintStart_toEndOf="@id/ivAnchorStatus"
        app:layout_constraintEnd_toStartOf="@id/tvAnchorResult" />

    <!-- 右侧核验结果文字（14sp） -->
    <TextView
        android:id="@+id/tvAnchorResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alert_safe"
        android:textSize="14sp"
        android:textColor="@color/text_on_dark"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/ivAnchorStatus"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/spacing_small" />

    <!-- 可展开的证据详情（默认隐藏） -->
    <LinearLayout
        android:id="@+id/evidenceDetailContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvAnchorName"
        app:layout_constraintStart_toEndOf="@id/ivAnchorStatus"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_small"
        android:paddingStart="@dimen/spacing_small">

        <TextView
            android:id="@+id/tvEvidenceDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alert_description"
            android:textSize="@dimen/text_size_hint"
            android:textColor="@color/text_on_dark"
            android:lineSpacingExtra="@dimen/line_spacing_small"
            android:alpha="0.85" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
