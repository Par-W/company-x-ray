<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alert_red"
    tools:context=".ui.alert.RiskAlertActivity">

    <!-- 垂直滚动内容区 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomActionArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_padding_horizontal"
            android:paddingTop="@dimen/spacing_xlarge"
            android:paddingBottom="@dimen/spacing_large">

            <!-- 风险图标（64dp） -->
            <ImageView
                android:id="@+id/ivRiskIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_dialog_alert"
                android:contentDescription="@null"
                app:tint="@color/text_on_dark"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 标题（28sp） -->
            <TextView
                android:id="@+id/tvAlertTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/alert_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_dark"
                app:layout_constraintTop_toTopOf="@id/ivRiskIcon"
                app:layout_constraintStart_toEndOf="@id/ivRiskIcon"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/spacing_medium" />

            <!-- 等级徽章（圆角胶囊） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/badgeRiskLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvAlertTitle"
                app:layout_constraintStart_toEndOf="@id/ivRiskIcon"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_small">

                <TextView
                    android:id="@+id/tvRiskLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_high_risk"
                    android:textSize="@dimen/text_size_hint"
                    android:textStyle="bold"
                    android:textColor="@color/risk_high"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:paddingVertical="@dimen/spacing_xsmall" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 信息卡片：收款商家 + 付款金额 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="@dimen/elevation_card_high"
                app:layout_constraintTop_toBottomOf="@id/badgeRiskLevel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_large">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_large">

                    <!-- 收款商家 -->
                    <TextView
                        android:id="@+id/tvMerchantLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_type"
                        android:textSize="@dimen/text_size_hint"
                        android:textColor="@color/text_hint"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvMerchantName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="某电商平台"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        app:layout_constraintTop_toBottomOf="@id/tvMerchantLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="@dimen/spacing_xsmall" />

                    <!-- 付款金额（特大号字） -->
                    <TextView
                        android:id="@+id/tvAmountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alert_payment_risk"
                        android:textSize="@dimen/text_size_hint"
                        android:textColor="@color/text_hint"
                        app:layout_constraintTop_toBottomOf="@id/tvMerchantName"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="@dimen/spacing_large" />

                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="¥ 0.00"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        android:textColor="@color/risk_high"
                        app:layout_constraintTop_toBottomOf="@id/tvAmountLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="@dimen/spacing_xsmall" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 透明度进度条（可选，没有就隐藏） -->
            <LinearLayout
                android:id="@+id/progressBarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/cardPaymentInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_large">

                <TextView
                    android:id="@+id/tvProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading"
                    android:textSize="@dimen/text_size_hint"
                    android:textColor="@color/text_on_dark"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    app:indicatorColor="@android:color/white"
                    app:trackColor="@android:color/white"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    android:indeterminate="false"
                    android:progress="60" />
            </LinearLayout>

            <!-- 六锚点标题 -->
            <TextView
                android:id="@+id/tvAnchorsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alert_suggestion"
                android:textSize="@dimen/text_size_subhead"
                android:textStyle="bold"
                android:textColor="@color/text_on_dark"
                app:layout_constraintTop_toBottomOf="@id/cardPaymentInfo"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/spacing_xlarge" />

            <!-- 锚点列表容器 -->
            <LinearLayout
                android:id="@+id/anchorsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvAnchorsTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium">

                <!-- 锚点项1 -->
                <include layout="@layout/item_anchor"
                    android:id="@+id/anchor1" />

                <!-- 锚点项2 -->
                <include layout="@layout/item_anchor"
                    android:id="@+id/anchor2" />

                <!-- 锚点项3 -->
                <include layout="@layout/item_anchor"
                    android:id="@+id/anchor3" />

                <!-- 锚点项4 -->
                <include layout="@layout/item_anchor"
                    android:id="@+id/anchor4" />

                <!-- 锚点项5 -->
                <include layout="@layout/item_anchor"
                    android:id="@+id/anchor5" />

                <!-- 锚点项6 -->
                <include layout="@layout/item_anchor"
                    android:id="@+id/anchor6" />
            </LinearLayout>

            <!-- 建议文案框（半透明背景卡片） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSuggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="#4DFFFFFF"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/anchorsContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_large">

                    <ImageView
                        android:layout_width="@dimen/icon_size_normal"
                        android:layout_height="@dimen/icon_size_normal"
                        android:src="@android:drawable/ic_dialog_info"
                        android:contentDescription="@null"
                        app:tint="@color/text_on_dark"
                        android:layout_marginEnd="@dimen/spacing_medium" />

                    <TextView
                        android:id="@+id/tvSuggestion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/alert_suggestion"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/text_on_dark"
                        android:lineSpacingExtra="@dimen/line_spacing" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "查看官方证据" 可展开按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleEvidence"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_normal"
                android:text="@string/history_detail"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/text_on_dark"
                app:cornerRadius="@dimen/corner_radius_button"
                app:strokeColor="@color/text_on_dark"
                app:icon="@android:drawable/arrow_down_float"
                app:iconTint="@color/text_on_dark"
                app:iconGravity="end"
                app:layout_constraintTop_toBottomOf="@id/cardSuggestion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_large" />

            <!-- 证据链接列表（展开后显示） -->
            <LinearLayout
                android:id="@+id/evidenceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/btnToggleEvidence"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="证据链接1"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_on_dark"
                    android:paddingVertical="@dimen/spacing_small"
                    android:drawablePadding="@dimen/spacing_small"
                    app:drawableStartCompat="@android:drawable/ic_menu_view"
                    app:tint="@color/text_on_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="证据链接2"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_on_dark"
                    android:paddingVertical="@dimen/spacing_small"
                    android:drawablePadding="@dimen/spacing_small"
                    app:drawableStartCompat="@android:drawable/ic_menu_view"
                    app:tint="@color/text_on_dark" />
            </LinearLayout>

            <!-- 底部间距占位 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xlarge"
                app:layout_constraintTop_toBottomOf="@id/evidenceContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部操作区 -->
    <LinearLayout
        android:id="@+id/bottomActionArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding_horizontal"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_xlarge"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 主按钮：通知家人帮我核实（白色背景，最醒目） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifyFamily"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_large"
            android:text="@string/alert_call_family"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            android:textColor="@color/risk_high"
            app:cornerRadius="@dimen/corner_radius_button"
            app:backgroundTint="@android:color/white"
            app:icon="@android:drawable/ic_menu_call"
            app:iconTint="@color/risk_high"
            app:iconGravity="textStart"
            app:iconSize="28dp" />

        <!-- 次按钮：返回付款页（描边按钮） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToPayment"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_normal"
            android:text="@string/back"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_on_dark"
            app:cornerRadius="@dimen/corner_radius_button"
            app:strokeColor="@color/text_on_dark"
            app:strokeWidth="2dp"
            app:icon="@android:drawable/ic_media_previous"
            app:iconTint="@color/text_on_dark"
            app:iconGravity="textStart"
            android:layout_marginTop="@dimen/spacing_medium" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
