<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_padding_horizontal"
    android:paddingVertical="@dimen/page_padding_vertical"
    tools:context=".ui.onboarding.PermissionGuideFragment">

    <!-- 大图标（顶部居中） -->
    <ImageView
        android:id="@+id/ivPermissionIcon"
        android:layout_width="@dimen/icon_size_xxlarge"
        android:layout_height="@dimen/icon_size_xxlarge"
        android:src="@drawable/ic_shield"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_xlarge" />

    <!-- 标题（24sp 加粗） -->
    <TextView
        android:id="@+id/tvPermissionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_title_permission"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ivPermissionIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_large" />

    <!-- 说明文字（18sp，多行） -->
    <TextView
        android:id="@+id/tvPermissionDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_desc_permission"
        android:textSize="@dimen/text_size_body"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/line_spacing"
        app:layout_constraintTop_toBottomOf="@id/tvPermissionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_medium" />

    <!-- 功能特点列表卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFeatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/corner_radius_card"
        app:cardElevation="@dimen/elevation_card"
        app:layout_constraintTop_toBottomOf="@id/tvPermissionDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_medium">

                <ImageView
                    android:layout_width="@dimen/icon_size_normal"
                    android:layout_height="@dimen/icon_size_normal"
                    android:src="@drawable/ic_shield"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_payment_risk"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="@dimen/spacing_medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_medium">

                <ImageView
                    android:layout_width="@dimen/icon_size_normal"
                    android:layout_height="@dimen/icon_size_normal"
                    android:src="@drawable/ic_shield"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_risky_url"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="@dimen/spacing_medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_size_normal"
                    android:layout_height="@dimen/icon_size_normal"
                    android:src="@drawable/ic_shield"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_fake_app"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="@dimen/spacing_medium" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 底部弹性空间 -->
    <Space
        android:id="@+id/spaceBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardFeatures"
        app:layout_constraintBottom_toTopOf="@id/btnGrantPermission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "去开启"大按钮（64dp高） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGrantPermission"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_large"
        android:text="@string/onboarding_grant_accessibility"
        android:textSize="@dimen/text_size_button"
        android:textStyle="bold"
        app:cornerRadius="@dimen/corner_radius_button"
        app:backgroundTint="@color/button_primary"
        app:layout_constraintBottom_toTopOf="@id/tvWhyPermission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/spacing_medium" />

    <!-- "为什么需要这个权限"小字说明 -->
    <TextView
        android:id="@+id/tvWhyPermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_privacy"
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/text_hint"
        android:drawablePadding="@dimen/spacing_xsmall"
        app:drawableStartCompat="@android:drawable/ic_menu_info_details"
        app:tint="@color/text_hint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/spacing_medium" />

</androidx.constraintlayout.widget.ConstraintLayout>
