<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <!-- 简化版风险提醒卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFloatingAlert"
        android:layout_width="@dimen/floating_alert_width"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/floating_alert_corner"
        app:cardElevation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_large">

            <!-- 顶部色条（风险等级指示） -->
            <View
                android:id="@+id/viewTopColorBar"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@color/risk_high"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 风险图标 -->
            <ImageView
                android:id="@+id/ivRiskIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_dialog_alert"
                android:contentDescription="@null"
                app:tint="@color/risk_high"
                app:layout_constraintTop_toBottomOf="@id/viewTopColorBar"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/spacing_medium" />

            <!-- 标题 -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/floating_alert_title"
                android:textSize="@dimen/text_size_subhead"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/viewTopColorBar"
                app:layout_constraintStart_toEndOf="@id/ivRiskIcon"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_medium" />

            <!-- 金额 -->
            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="¥ 0.00"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold"
                android:textColor="@color/risk_high"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toEndOf="@id/ivRiskIcon"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_xsmall" />

            <!-- 简要锚点结果（3-4行） -->
            <LinearLayout
                android:id="@+id/anchorsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvAmount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/spacing_xsmall">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:contentDescription="@null"
                        app:tint="@color/risk_high" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/alert_payment_risk"
                        android:textSize="@dimen/text_size_hint"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alert_safe"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/risk_high" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/spacing_xsmall">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:contentDescription="@null"
                        app:tint="@color/risk_medium" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/alert_risky_url"
                        android:textSize="@dimen/text_size_hint"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alert_medium_risk"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/risk_medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/spacing_xsmall">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_check"
                        android:contentDescription="@null"
                        app:tint="@color/risk_low" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/alert_fake_app"
                        android:textSize="@dimen/text_size_hint"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alert_safe"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/risk_low" />
                </LinearLayout>
            </LinearLayout>

            <!-- "查看详情" 提示 -->
            <TextView
                android:id="@+id/tvTapToView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/floating_alert_tap_to_view"
                android:textSize="@dimen/text_size_hint"
                android:textColor="@color/text_hint"
                app:layout_constraintTop_toBottomOf="@id/anchorsContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium" />

            <!-- 按钮区域 -->
            <LinearLayout
                android:id="@+id/buttonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvTapToView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_large">

                <!-- 通知家人按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotifyFamily"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_normal"
                    android:layout_weight="1"
                    android:text="@string/alert_call_family"
                    android:textSize="@dimen/text_size_hint"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/corner_radius_button_small"
                    app:backgroundTint="@color/button_primary"
                    app:icon="@android:drawable/ic_menu_call"
                    app:iconGravity="textStart"
                    app:iconSize="20dp" />

                <!-- 长按关闭提示 -->
                <TextView
                    android:id="@+id/tvLongPressClose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/close"
                    android:textSize="@dimen/text_size_hint"
                    android:textColor="@color/text_hint"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:padding="@dimen/spacing_medium" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
