<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/familyItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingVertical="@dimen/padding_medium">

    <!-- 头像（圆形） -->
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/avatar_size_normal"
        android:layout_height="@dimen/avatar_size_normal"
        android:src="@android:drawable/ic_menu_call"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_avatar_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 姓名 + 关系 -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="张三"
        android:textSize="@dimen/text_size_subhead"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/ivAvatar"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintEnd_toStartOf="@id/btnMore"
        android:layout_marginStart="@dimen/spacing_medium" />

    <TextView
        android:id="@+id/tvRelationship"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/family_relation_son"
        android:textSize="@dimen/text_size_body"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintEnd_toStartOf="@id/btnMore"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_xsmall" />

    <!-- 角色标签（守护人/被守护人） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/badgeRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/risk_low_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvRelationship"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_small">

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/family_title"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/risk_low_dark"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="2dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 右侧操作按钮（更多） -->
    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:src="@android:drawable/ic_menu_more"
        android:contentDescription="@string/settings_title"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/spacing_small"
        app:tint="@color/text_hint"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
