<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================= -->
    <!--  字体尺寸 - 长辈友好，整体偏大            -->
    <!-- ========================================= -->

    <!-- 超大标题（如风险警示） -->
    <dimen name="text_size_title">32sp</dimen>
    <!-- 页面大标题 -->
    <dimen name="text_size_headline">28sp</dimen>
    <!-- 次级标题/小标题 -->
    <dimen name="text_size_subhead">22sp</dimen>
    <!-- 正文（比标准偏大，方便长辈阅读） -->
    <dimen name="text_size_body">18sp</dimen>
    <!-- 按钮文字 -->
    <dimen name="text_size_button">20sp</dimen>
    <!-- 提示/辅助文字 -->
    <dimen name="text_size_hint">16sp</dimen>
    <!-- 小号文字（尽量少用） -->
    <dimen name="text_size_small">14sp</dimen>

    <!-- 行间距 -->
    <dimen name="line_spacing">6dp</dimen>
    <dimen name="line_spacing_small">4dp</dimen>
    <dimen name="line_spacing_large">10dp</dimen>

    <!-- ========================================= -->
    <!--  间距尺寸                                -->
    <!-- ========================================= -->

    <!-- 超小间距 -->
    <dimen name="spacing_xsmall">4dp</dimen>
    <!-- 小间距 -->
    <dimen name="spacing_small">8dp</dimen>
    <!-- 中间距 -->
    <dimen name="spacing_medium">16dp</dimen>
    <!-- 大间距 -->
    <dimen name="spacing_large">24dp</dimen>
    <!-- 超大间距 -->
    <dimen name="spacing_xlarge">32dp</dimen>
    <!-- 页面边距 -->
    <dimen name="page_padding">20dp</dimen>
    <dimen name="page_padding_horizontal">24dp</dimen>
    <dimen name="page_padding_vertical">20dp</dimen>

    <!-- padding 通用 -->
    <dimen name="padding_small">8dp</dimen>
    <dimen name="padding_medium">16dp</dimen>
    <dimen name="padding_large">24dp</dimen>
    <dimen name="padding_xlarge">32dp</dimen>

    <!-- margin 通用 -->
    <dimen name="margin_small">8dp</dimen>
    <dimen name="margin_medium">16dp</dimen>
    <dimen name="margin_large">24dp</dimen>
    <dimen name="margin_xlarge">32dp</dimen>

    <!-- ========================================= -->
    <!--  按钮尺寸 - 长辈友好，大尺寸易点击        -->
    <!-- ========================================= -->

    <!-- 大按钮高度（主操作按钮） -->
    <dimen name="button_height_large">64dp</dimen>
    <!-- 普通按钮高度 -->
    <dimen name="button_height_normal">56dp</dimen>
    <!-- 小按钮高度 -->
    <dimen name="button_height_small">48dp</dimen>
    <!-- 按钮最小宽度 -->
    <dimen name="button_min_width">200dp</dimen>
    <!-- 按钮圆角 -->
    <dimen name="corner_radius_button">12dp</dimen>
    <dimen name="corner_radius_button_small">8dp</dimen>

    <!-- ========================================= -->
    <!--  卡片/容器尺寸                           -->
    <!-- ========================================= -->

    <!-- 卡片圆角 -->
    <dimen name="corner_radius_card">16dp</dimen>
    <dimen name="corner_radius_card_small">12dp</dimen>
    <!-- 卡片高度（阴影） -->
    <dimen name="elevation_card">4dp</dimen>
    <dimen name="elevation_card_high">8dp</dimen>

    <!-- ========================================= -->
    <!--  输入框尺寸                              -->
    <!-- ========================================= -->

    <dimen name="input_height">60dp</dimen>
    <dimen name="input_corner_radius">12dp</dimen>

    <!-- ========================================= -->
    <!--  图标尺寸                                -->
    <!-- ========================================= -->

    <dimen name="icon_size_small">24dp</dimen>
    <dimen name="icon_size_normal">32dp</dimen>
    <dimen name="icon_size_large">48dp</dimen>
    <dimen name="icon_size_xlarge">72dp</dimen>
    <dimen name="icon_size_xxlarge">96dp</dimen>

    <!-- ========================================= -->
    <!--  顶部栏/导航栏尺寸                       -->
    <!-- ========================================= -->

    <dimen name="toolbar_height">64dp</dimen>
    <dimen name="bottom_nav_height">72dp</dimen>
    <dimen name="bottom_nav_icon_size">28dp</dimen>
    <dimen name="bottom_nav_text_size">14sp</dimen>

    <!-- ========================================= -->
    <!--  悬浮窗尺寸                              -->
    <!-- ========================================= -->

    <dimen name="floating_alert_width">320dp</dimen>
    <dimen name="floating_alert_min_height">120dp</dimen>
    <dimen name="floating_alert_corner">16dp</dimen>

    <!-- ========================================= -->
    <!--  列表项尺寸                              -->
    <!-- ========================================= -->

    <dimen name="list_item_height">72dp</dimen>
    <dimen name="list_item_padding">16dp</dimen>
    <dimen name="list_divider_height">1dp</dimen>

    <!-- ========================================= -->
    <!--  头像/圆形图标尺寸                       -->
    <!-- ========================================= -->

    <dimen name="avatar_size_small">40dp</dimen>
    <dimen name="avatar_size_normal">56dp</dimen>
    <dimen name="avatar_size_large">80dp</dimen>
    <dimen name="avatar_size_xlarge">120dp</dimen>

</resources>
