<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================================= -->
    <!--  按钮样式 - 长辈友好：大尺寸、高对比度    -->
    <!-- ========================================= -->

    <!-- 主按钮 - 大尺寸 -->
    <style name="GuardianButton.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height_large</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/button_primary</item>
        <item name="cornerRadius">@dimen/corner_radius_button</item>
        <item name="android:paddingLeft">@dimen/padding_large</item>
        <item name="android:paddingRight">@dimen/padding_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 危险按钮（红色） -->
    <style name="GuardianButton.Danger" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height_large</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textColor">@color/on_risk_high</item>
        <item name="backgroundTint">@color/button_danger</item>
        <item name="cornerRadius">@dimen/corner_radius_button</item>
        <item name="android:paddingLeft">@dimen/padding_large</item>
        <item name="android:paddingRight">@dimen/padding_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 警告按钮（橙色） -->
    <style name="GuardianButton.Warning" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height_large</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textColor">@color/on_risk_medium</item>
        <item name="backgroundTint">@color/button_warning</item>
        <item name="cornerRadius">@dimen/corner_radius_button</item>
        <item name="android:paddingLeft">@dimen/padding_large</item>
        <item name="android:paddingRight">@dimen/padding_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 次要按钮（描边） -->
    <style name="GuardianButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height_large</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">@dimen/corner_radius_button</item>
        <item name="android:paddingLeft">@dimen/padding_large</item>
        <item name="android:paddingRight">@dimen/padding_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 文字按钮 -->
    <style name="GuardianButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:padding">@dimen/padding_medium</item>
    </style>

    <!-- ========================================= -->
    <!--  文字样式 - 长辈友好：大字号、高对比度    -->
    <!-- ========================================= -->

    <!-- 超大标题 -->
    <style name="GuardianText.Title" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">@dimen/line_spacing_small</item>
    </style>

    <!-- 页面大标题 -->
    <style name="GuardianText.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 次级标题 -->
    <style name="GuardianText.Subhead" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_subhead</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 正文 -->
    <style name="GuardianText.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">@dimen/line_spacing</item>
    </style>

    <!-- 次要文字 -->
    <style name="GuardianText.Body.Secondary" parent="GuardianText.Body">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 提示文字 -->
    <style name="GuardianText.Hint" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_hint</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <!-- 警示大文字 -->
    <style name="GuardianText.Alert" parent="GuardianText.Title">
        <item name="android:textColor">@color/risk_high</item>
    </style>

    <!-- ========================================= -->
    <!--  卡片样式                                -->
    <!-- ========================================= -->

    <style name="GuardianCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="android:layout_margin">@dimen/margin_medium</item>
    </style>

    <!-- 高危卡片 -->
    <style name="GuardianCard.HighRisk" parent="GuardianCard">
        <item name="cardBackgroundColor">@color/risk_high_bg</item>
        <item name="strokeColor">@color/risk_high</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- 中危卡片 -->
    <style name="GuardianCard.MediumRisk" parent="GuardianCard">
        <item name="cardBackgroundColor">@color/risk_medium_bg</item>
        <item name="strokeColor">@color/risk_medium</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- 安全卡片 -->
    <style name="GuardianCard.Safe" parent="GuardianCard">
        <item name="cardBackgroundColor">@color/risk_low_bg</item>
        <item name="strokeColor">@color/risk_low</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- ========================================= -->
    <!--  输入框样式                              -->
    <!-- ========================================= -->

    <style name="GuardianEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:padding">@dimen/padding_large</item>
        <item name="android:minHeight">@dimen/input_height</item>
    </style>

    <!-- ========================================= -->
    <!--  顶部工具栏                              -->
    <!-- ========================================= -->

    <style name="GuardianToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="android:titleTextColor">@color/on_primary</item>
        <item name="titleTextAppearance">@style/GuardianToolbarTitle</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
    </style>

    <style name="GuardianToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_subhead</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ========================================= -->
    <!--  风险等级标签                            -->
    <!-- ========================================= -->

    <style name="RiskTag">
        <item name="android:textSize">@dimen/text_size_hint</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">@dimen/padding_small</item>
        <item name="android:paddingRight">@dimen/padding_small</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="RiskTag.High" parent="RiskTag">
        <item name="android:textColor">@color/on_risk_high</item>
        <item name="android:background">@drawable/bg_alert_red</item>
    </style>

    <style name="RiskTag.Medium" parent="RiskTag">
        <item name="android:textColor">@color/on_risk_medium</item>
        <item name="android:background">@drawable/bg_alert_yellow</item>
    </style>

    <style name="RiskTag.Low" parent="RiskTag">
        <item name="android:textColor">@color/on_risk_low</item>
        <item name="android:background">@drawable/bg_alert_green</item>
    </style>

</resources>
